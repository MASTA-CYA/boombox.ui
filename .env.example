# Copy this file to .env and fill in your own values.
# .env is git-ignored - it stays on your machine and is never committed.
# See README.md > Configuration for where to get each one.

# Google Custom Search JSON API key + Search Engine ID, used by
# MediaArtService to look up missing artist/album art.
# Get these from the Google Cloud Console (APIs & Services > Credentials,
# and the Programmable Search Engine control panel for the CX id):
# https://console.cloud.google.com/apis/credentials
# https://programmablesearchengine.google.com/controlpanel/all
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX_KEY=

# Discogs personal access token, used by MetaDataService to look up track
# genre, artist, and bio info.
# Get one from https://www.discogs.com/settings/developers
DISCOGS_AUTH_TOKEN=
